{
  "name": "@kronos-ts/eventsourcing",
  "version": "0.3.3",
  "description": "Event sourcing for Kronos \u2014 dynamic-consistency-boundary event store with load/append.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "Theo Emanuelsson",
  "homepage": "https://github.com/KronosDB/kronos-ts/tree/main/packages/eventsourcing#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KronosDB/kronos-ts.git",
    "directory": "packages/eventsourcing"
  },
  "bugs": {
    "url": "https://github.com/KronosDB/kronos-ts/issues"
  },
  "keywords": [
    "kronos",
    "event-sourcing",
    "cqrs",
    "dcb",
    "typescript"
  ],
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.ts",
    "!src/**/*.bench.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@kronos-ts/common": "workspace:*",
    "@kronos-ts/messaging": "workspace:*",
    "@kronos-ts/modelling": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@kronos-ts/app": "workspace:*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./append": "./src/append.ts",
    "./load": "./src/load.ts",
    "./schedule": "./src/schedule.ts"
  }
}
