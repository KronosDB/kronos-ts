{
  "name": "@kronos-ts/postgres",
  "version": "0.10.0",
  "description": "PostgreSQL extension for Kronos — event store and snapshot store adapters.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "Theo Emanuelsson",
  "homepage": "https://github.com/KronosDB/kronos-ts/tree/main/packages/postgres#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KronosDB/kronos-ts.git",
    "directory": "packages/postgres"
  },
  "bugs": {
    "url": "https://github.com/KronosDB/kronos-ts/issues"
  },
  "keywords": [
    "kronos",
    "event-sourcing",
    "cqrs",
    "dcb",
    "typescript",
    "postgres",
    "postgresql"
  ],
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./adapters/pg": "./src/adapters/pg.ts",
    "./adapters/postgres": "./src/adapters/postgres.ts",
    "./adapters/bun-sql": "./src/adapters/bun-sql.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.ts",
    "!src/**/*.bench.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./adapters/pg": {
        "types": "./dist/adapters/pg.d.ts",
        "default": "./dist/adapters/pg.js"
      },
      "./adapters/postgres": {
        "types": "./dist/adapters/postgres.d.ts",
        "default": "./dist/adapters/postgres.js"
      },
      "./adapters/bun-sql": {
        "types": "./dist/adapters/bun-sql.d.ts",
        "default": "./dist/adapters/bun-sql.js"
      }
    }
  },
  "dependencies": {
    "@kronos-ts/core": "workspace:*"
  },
  "peerDependencies": {
    "pg": ">=8.0.0",
    "postgres": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "pg": "^8.20.0",
    "@types/pg": "^8.11.0",
    "postgres": "^3.4.9",
    "testcontainers": "^11.14.0"
  }
}
