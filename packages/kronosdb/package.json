{
  "name": "@kronos-ts/kronosdb",
  "version": "0.11.0",
  "description": "KronosDB extension for Kronos — event store with snapshotting and scheduling tiers, command and query transport, and control plane.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "Theo Emanuelsson",
  "homepage": "https://github.com/KronosDB/kronos-ts/tree/main/packages/kronosdb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KronosDB/kronos-ts.git",
    "directory": "packages/kronosdb"
  },
  "bugs": {
    "url": "https://github.com/KronosDB/kronos-ts/issues"
  },
  "keywords": [
    "kronos",
    "event-sourcing",
    "cqrs",
    "dcb",
    "typescript",
    "kronosdb"
  ],
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.ts",
    "!src/**/*.bench.ts"
  ],
  "scripts": {
    "vendor-protocol": "bun scripts/vendor-protocol.ts",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@kronos-ts/core": "workspace:*"
  },
  "devDependencies": {
    "testcontainers": "^11.13.0",
    "zod": "^4.3.6"
  }
}
