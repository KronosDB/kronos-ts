{
  "name": "@kronos-ts/messaging",
  "version": "0.8.0",
  "description": "Messaging primitives for Kronos — commands, events, handlers, and event processors.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "Theo Emanuelsson",
  "homepage": "https://github.com/KronosDB/kronos-ts/tree/main/packages/messaging#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KronosDB/kronos-ts.git",
    "directory": "packages/messaging"
  },
  "bugs": {
    "url": "https://github.com/KronosDB/kronos-ts/issues"
  },
  "keywords": [
    "kronos",
    "event-sourcing",
    "cqrs",
    "dcb",
    "typescript"
  ],
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./processing-state": "./src/processing-state.ts",
    "./correlation-data": "./src/correlation-data.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.ts",
    "!src/**/*.bench.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./processing-state": {
        "types": "./dist/processing-state.d.ts",
        "default": "./dist/processing-state.js"
      },
      "./correlation-data": {
        "types": "./dist/correlation-data.d.ts",
        "default": "./dist/correlation-data.js"
      }
    }
  },
  "dependencies": {
    "@kronos-ts/common": "workspace:*",
    "@kronos-ts/eventsourcing": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2"
  }
}
