{
  "name": "@kronos-ts/core",
  "version": "0.3.0",
  "description": "The Kronos core — task lifecycle, bus and store shapes, reference-following assembly, and the DCB model.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "Theo Emanuelsson",
  "homepage": "https://github.com/KronosDB/kronos-ts/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KronosDB/kronos-ts.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/KronosDB/kronos-ts/issues"
  },
  "keywords": [
    "kronos",
    "event-sourcing",
    "cqrs",
    "dcb",
    "typescript"
  ],
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.ts",
    "!src/**/*.bench.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "uuid": "^11"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "zod": "^4.3.6"
  }
}
