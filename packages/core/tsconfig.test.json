{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The messaging reliability test reads the transports' senders out of
    // their own packages, so the tests' root is the repository, not `src`.
    "rootDir": "../..",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "bun-types"]
  },
  "include": ["src"],
  "exclude": []
}
