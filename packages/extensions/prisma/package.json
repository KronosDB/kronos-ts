{
  "name": "@kronos-ts/prisma",
  "version": "0.2.8",
  "description": "Prisma extension for Kronos.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "Theo Emanuelsson",
  "homepage": "https://github.com/KronosDB/kronos-ts/tree/main/packages/extensions/prisma#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KronosDB/kronos-ts.git",
    "directory": "packages/extensions/prisma"
  },
  "bugs": {
    "url": "https://github.com/KronosDB/kronos-ts/issues"
  },
  "keywords": [
    "kronos",
    "event-sourcing",
    "cqrs",
    "dcb",
    "typescript",
    "prisma",
    "orm"
  ],
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.ts",
    "!src/**/*.bench.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@kronos-ts/common": "workspace:*",
    "@kronos-ts/messaging": "workspace:*"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0"
  }
}
