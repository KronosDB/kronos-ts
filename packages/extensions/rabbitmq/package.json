{
  "name": "@kronos-ts/rabbitmq",
  "version": "0.3.1",
  "description": "RabbitMQ extension for Kronos — distributed command and query transport.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "Theo Emanuelsson",
  "homepage": "https://github.com/KronosDB/kronos-ts/tree/main/packages/extensions/rabbitmq#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KronosDB/kronos-ts.git",
    "directory": "packages/extensions/rabbitmq"
  },
  "bugs": {
    "url": "https://github.com/KronosDB/kronos-ts/issues"
  },
  "keywords": [
    "kronos",
    "event-sourcing",
    "cqrs",
    "dcb",
    "typescript",
    "rabbitmq",
    "amqp"
  ],
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.ts",
    "!src/**/*.bench.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@kronos-ts/common": "workspace:*",
    "@kronos-ts/app": "workspace:*",
    "@kronos-ts/eventsourcing": "workspace:*",
    "@kronos-ts/messaging": "workspace:*",
    "@kronos-ts/modelling": "workspace:*"
  },
  "peerDependencies": {
    "amqplib": ">=0.10.0"
  },
  "peerDependenciesMeta": {
    "amqplib": {
      "optional": true
    }
  },
  "devDependencies": {
    "amqplib": "^0.10.5",
    "@types/amqplib": "^0.10.7",
    "testcontainers": "^11.14.0",
    "zod": "^4.3.6"
  }
}
