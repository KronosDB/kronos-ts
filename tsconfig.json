{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  // `integrationtests/examples` IS INCLUDED. The examples are the surface a
  // reader copies from, so they are held to the same compiler as the code —
  // they had drifted through three renames while nothing compiled them.
  "include": ["packages/*/src", "integrationtests/src", "integrationtests/examples"],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.bench.ts"
  ],
  // `files` is NOT subject to `exclude`, so a type-level test can live beside
  // its runtime siblings in `__tests__` (where the package build and the
  // published `files` list already drop it) and still be judged by this gate.
  // Without it a `@ts-expect-error` claim would be decoration: nothing compiles
  // the tests.
  "files": [
    "packages/drizzle/src/__tests__/drizzle-handler-inference.types.ts",
    "packages/test/src/__tests__/time-demand.types.ts",
    "packages/drizzle/src/__tests__/correlating-drizzle-stacking.types.ts",
    "packages/core/src/correlation/__tests__/correlation-demand.types.ts",
    "packages/core/src/event-sourcing/__tests__/snapshot-demand.types.ts",
    "packages/core/src/event-scheduling/__tests__/schedule-demand.types.ts",
    "packages/core/src/query-handling/__tests__/subscription-demand.types.ts",
    "packages/core/src/event-processing/__tests__/processor-demands.types.ts",
    "integrationtests/src/__tests__/capability-preservation.types.ts",
    "packages/rabbitmq/src/__tests__/transport-capability-preservation.types.ts",
    "packages/core/src/messaging/__tests__/standard-schema.types.ts",
    "packages/core/src/event-sourcing/__tests__/state-initial.types.ts",
    "packages/core/src/validation/__tests__/validation-composition.types.ts"
  ]
}
